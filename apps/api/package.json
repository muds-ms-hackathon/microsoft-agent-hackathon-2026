{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "prisma-dbml-generator": "^0.12.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1",
    "yaml": "^2.9.0"
  }
}
