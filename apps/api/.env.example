# =====================
# API サーバー環境変数
# =====================
# `apps/api/` ディレクトリで起動時に読み込まれる。
# NODE_ENV=production では全必須変数が未設定の場合に起動時 throw する（fail-fast）。

# ---- データベース ----

DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ---- OIDC / 認証設定 ----

# OIDC プロバイダのイシュアー URL
# - fake-auth (ローカル開発): http://localhost:3007
# - Entra External ID (CIAM): https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0
OIDC_ISSUER_URL="http://localhost:3007"

# JWT の audience クレーム（トークンの aud と一致している必要がある）
# - fake-auth (ローカル開発): fake-auth-client
# - Entra External ID: <client-id>
OIDC_AUDIENCE="fake-auth-client"

# ---- サーバー設定 ----

# CORS で許可するオリジン（カンマ区切り、例: http://localhost:5173,https://example.com）
ALLOWED_ORIGINS=""
