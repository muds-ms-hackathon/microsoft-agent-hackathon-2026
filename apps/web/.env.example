# =====================
# Vite (web) 環境変数
# =====================
# `apps/web/` ディレクトリで `vite` 起動時に読み込まれる。
# クライアント側に露出するため、機密情報を入れないこと。

# 認証プロバイダの選択。
# "fake-auth": ローカル開発用 OIDC プロバイダ（services/fake-auth）を使用
# "entra"    : Azure Entra External ID (CIAM) を使用
VITE_AUTH_PROVIDER="fake-auth"

# ---- fake-auth 設定 (VITE_AUTH_PROVIDER=fake-auth のときのみ使用) ----

# fake-auth (OIDC Provider) のオリジン。
# - 開発時 (vite dev): 未設定なら http://localhost:3007 にフォールバック。
# - 本番ビルド時 (vite build with PROD): 未設定だとビルド成果物の起動時に
#   "Required Vite env \"VITE_FAKE_AUTH_URL\" is not set." を throw する。
VITE_FAKE_AUTH_URL="http://localhost:3007"

# ---- Entra External ID (CIAM) 設定 (VITE_AUTH_PROVIDER=entra のときのみ使用) ----

# Azure ポータルのアプリ登録で発行されるクライアント ID
VITE_ENTRA_CLIENT_ID=""

# テナントの権限エンドポイント
# 例: https://<tenant-name>.ciamlogin.com/<tenant-id>
VITE_ENTRA_AUTHORITY=""

# 認証後のリダイレクト先 URI。
# Azure ポータル > アプリの登録 > 認証 > リダイレクト URI に同じ値を登録すること。
VITE_ENTRA_REDIRECT_URI="http://localhost:5173/login"
